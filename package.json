{
    "name": "pg-language-server",
    "displayName": "PG Lanbuage Server",
    "description": "Code navigation, autocompletion, syntax checking, and linting for WeBWorK PG problem files",
    "author": "Glenn Rice <grice1@missouriwestern.edu>",
    "license": "MIT",
    "version": "0.0.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/drgrice1/pg-language-server"
    },
    "publisher": "grice1@missouriwestern.edu",
    "keywords": [
        "pg",
        "WeBWorK",
        "perl",
        "coc.nvim",
        "lsp",
        "languageserver"
    ],
    "engines": {
        "coc": "^0.0.82",
        "vscode": "^1.53.0"
    },
    "main": "vscode-client/dist/extension.js",
    "activationEvents": [
        "workspaceContains:**/*.pg",
        "onLanguage:pg"
    ],
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "PG Language Server",
            "properties": {
                "pg.perlPath": {
                    "scope": "resource",
                    "type": "string",
                    "default": "perl",
                    "description": "Full path to the perl executable."
                },
                "pg.perlParams": {
                    "scope": "resource",
                    "type": "array",
                    "default": [],
                    "description": "Pass miscellaneous command line arguments to pass to the perl executable."
                },
                "pg.perlEnv": {
                    "scope": "resource",
                    "type": "object",
                    "default": {},
                    "description": "Pass environment variables to the perl executable. Skipped if undefined."
                },
                "pg.perlEnvAdd": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "description": "Add environment variables to current environment, or totally replace (perlEnv related)."
                },
                "pg.enableWarnings": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": false,
                    "description": "Enable warnings using -Mwarnings command switch.  Most likely you don't want this."
                },
                "pg.perltidyProfile": {
                    "scope": "resource",
                    "type": "string",
                    "default": "",
                    "description": "Path to perl tidy profile. You can use $workspaceFolder as a placeholder."
                },
                "pg.perltidyEnabled": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "description": "Enable PG perl tidy."
                },
                "pg.perlcriticProfile": {
                    "scope": "resource",
                    "type": "string",
                    "default": "",
                    "description": "Path to pg critic profile. Otherwise will default to the internal default profile."
                },
                "pg.perlcriticEnabled": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "description": "Enable perl critic."
                },
                "pg.perlcriticSeverity": {
                    "scope": "resource",
                    "type": "number",
                    "description": "Override severity level for perl critic (normally in profile)."
                },
                "pg.perlcriticTheme": {
                    "scope": "resource",
                    "type": "string",
                    "description": "Override theme for perl critic (normally in profile)."
                },
                "pg.perlcriticExclude": {
                    "scope": "resource",
                    "type": "string",
                    "description": "Regex pattern with policies to exclude for perl critic (normally in profile)."
                },
                "pg.perlcriticInclude": {
                    "scope": "resource",
                    "type": "string",
                    "description": "Regex pattern with policies to include for perl critic (normally in profile)."
                },
                "pg.perlCompileEnabled": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "description": "Enable running perl -c on your code."
                },
                "pg.severity5": {
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "error",
                        "warning",
                        "info",
                        "hint",
                        "none"
                    ],
                    "default": "warning",
                    "description": "Editor Diagnostic severity level for Critic severity 5."
                },
                "pg.severity4": {
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "error",
                        "warning",
                        "info",
                        "hint",
                        "none"
                    ],
                    "default": "info",
                    "description": "Editor Diagnostic severity level for Critic severity 4."
                },
                "pg.severity3": {
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "error",
                        "warning",
                        "info",
                        "hint",
                        "none"
                    ],
                    "default": "hint",
                    "description": "Editor Diagnostic severity level for Critic severity 3."
                },
                "pg.severity2": {
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "error",
                        "warning",
                        "info",
                        "hint",
                        "none"
                    ],
                    "default": "hint",
                    "description": "Editor Diagnostic severity level for Critic severity 2."
                },
                "pg.severity1": {
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "error",
                        "warning",
                        "info",
                        "hint",
                        "none"
                    ],
                    "default": "hint",
                    "description": "Editor Diagnostic severity level for Critic severity 1."
                },
                "pg.includePaths": {
                    "scope": "resource",
                    "type": "array",
                    "default": [],
                    "description": "Array of paths added to @INC. You can use $workspaceFolder as a placeholder."
                },
                "pg.macroPaths": {
                    "scope": "resource",
                    "type": "array",
                    "default": [],
                    "description": "Array of paths to be searched for additional macros. You can use $workspaceFolder as a placeholder."
                },
                "pg.logging": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "description": "Log to stdout from the navigator. Viewable in the Perl Navigator LSP log."
                },
                "pg.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "messages",
                    "description": "Traces the communication between VS Code and the language server."
                }
            }
        }
    },
    "scripts": {
        "format:check": "prettier --check \"**/*.{js,cjs,ts,md,json}\"",
        "format:prettier": "prettier --write \"**/*.{js,cjs,ts,md,json}\"",
        "format": "npm run format:prettier",
        "lint:check": "eslint .",
        "lint:eslint": "eslint . --fix",
        "lint": "npm run lint:check",
        "compile": "tsc -b",
        "watch": "tsc -b -w",
        "build": "webpack --mode production --devtool hidden-source-map",
        "test": "mocha"
    },
    "devDependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/state": "^6.7.4",
        "@eslint/js": "^10.0.1",
        "@lezer/common": "^1.5.2",
        "@openwebwork/codemirror-lang-pg": "^0.0.6",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.20.2",
        "@types/uuid": "^10.0.0",
        "@types/vscode": "^1.137.0",
        "@types/webpack-env": "^1.18.8",
        "coc.nvim": "^0.0.83-next.9",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-mocha": "^12.0.2",
        "globals": "^17.12.0",
        "lru-cache": "^11.5.2",
        "mocha": "^12.0.1",
        "prettier": "^3.9.6",
        "ts-loader": "^9.6.2",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "uuid": "^14.0.2",
        "vscode-languageclient": "^10.1.1",
        "vscode-languageserver": "^10.1.1",
        "vscode-languageserver-textdocument": "^1.0.14",
        "vscode-uri": "^3.2.0",
        "webpack": "^5.110.3",
        "webpack-cli": "^7.2.3",
        "yaml": "^2.9.0"
    },
    "overrides": {
        "coc.nvim": {
            "@types/node": ">=20.14.10"
        }
    }
}
